{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClaudeReviewResponse v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "request_id", "task_id", "round", "decision", "claude_called", "advisory_only",
    "rounds_used", "rounds_remaining", "next_action"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "request_id": { "type": "string" },
    "task_id": { "type": "string" },
    "round": { "type": "integer", "minimum": 0 },
    "decision": {
      "enum": ["REVIEWED", "HUMAN_REVIEW_REQUIRED", "UNAVAILABLE", "CACHED"],
      "description": "HUMAN_REVIEW_REQUIRED = limite atingido ou tarefa escalada; claude_called é false."
    },
    "blocked_reason": {
      "enum": ["rounds_exhausted", "transport_failures", "repeated_fingerprint", "already_human_review"]
    },
    "claude_called": { "type": "boolean" },
    "advisory_only": { "const": true },
    "rounds_used": { "type": "integer", "minimum": 0 },
    "rounds_remaining": { "type": "integer", "minimum": 0 },
    "next_action": {
      "enum": ["APPLY_FIX_AND_REVALIDATE", "RETRY_SAME", "PUBLISH_IF_VALIDATOR_PASSES", "HOLD", "HUMAN_REVIEW_REQUIRED"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Presente quando claude_called = true.",
      "required": ["status", "problem", "probable_cause", "evidence", "suggested_fix", "risk", "publish", "confidence"],
      "properties": {
        "status": { "enum": ["OK", "ATENCAO", "ERRO", "INSUFICIENTE"] },
        "problem": { "type": "string", "maxLength": 600 },
        "probable_cause": { "type": "string", "maxLength": 600 },
        "evidence": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 8 },
        "suggested_fix": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reversible"],
          "properties": {
            "type": { "enum": ["none", "data_edit", "code_patch", "retry_other_image", "manual"] },
            "files": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
            "patch": { "type": "string", "maxLength": 20000, "description": "Diff unificado. Nunca aplicado automaticamente." },
            "steps": { "type": "array", "items": { "type": "string", "maxLength": 400 }, "maxItems": 10 },
            "reversible": { "type": "boolean" }
          }
        },
        "risk": { "enum": ["baixo", "medio", "alto"] },
        "publish": { "enum": ["SIM", "NAO", "REVALIDAR"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_more_data": { "type": "array", "items": { "type": "string", "maxLength": 300 }, "maxItems": 8 },
        "visual_checks": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["check", "result"],
            "properties": {
              "check": { "type": "string", "maxLength": 200 },
              "result": { "enum": ["pass", "fail", "unknown"] },
              "note": { "type": "string", "maxLength": 300 }
            }
          }
        }
      }
    },
    "model": { "type": "string" },
    "usage": {
      "type": "object",
      "properties": { "input_tokens": { "type": "integer" }, "output_tokens": { "type": "integer" } }
    },
    "review_file": { "type": "string", "description": "Caminho do parecer gravado em data/reviews/." },
    "created_at": { "type": "string" }
  }
}
